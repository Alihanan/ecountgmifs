use_negative = TRUE,
log1pCPM = TRUE) {
Y <- as.matrix(data_in)
mirna_in <- intersect(mirna_in, colnames(Y))
genes_in <- intersect(genes_in, colnames(Y))
if (log1pCPM) Y <- log1p_cpm(Y)
C <- cor(
Y[, mirna_in, drop = FALSE],
Y[, genes_in, drop = FALSE],
method = method
)
score <- if (use_negative) pmax(-C, 0) else abs(C)
if (!is.null(top_k)) {
top_k <- min(top_k, length(score))
thr <- sort(as.vector(score), decreasing = TRUE)[top_k]
adj <- score >= thr
} else {
adj <- score >= cutoff
}
storage.mode(adj) <- "integer"
adj
}
# ready
#   "data/BIO_combined_R1_R2_R3_nodes250_ratio100_150/",
all.folders = c(
"data/BIO_combined_R1_R2_R3_nodes250_ratio150_100/",
"data/BIO_mirna-mrna_nodes250/"
)
for(fld in all.folders){
browser()
print(fld)
fls = list.files(fld)
data_in = NULL
gt_in = NULL
noisy_in = NULL
for(f in fls){
print(f)
tst = read.csv(paste0(fld,f), row.names = 1,
check.names = T)
rownames(tst) = make.names(rownames(tst))
if(grepl("_DATA", f, fixed=T)){
data_in = tst
print("data")
}
if(grepl("_ADJACENCYNOISY", f, fixed=T)){
noisy_in = tst
print("noisy")
}
if(grepl("_ADJACENCYTRUE", f, fixed=T)){
gt_in = tst
print("ground truth")
}
}
if(is.null(data_in) || is.null(gt_in)){
stop("Folder missing data or GT")
}
rna_in = colnames(data_in)
stopifnot(length(rna_in) == sum(rna_in %in% all.both.rnas))
mirna_in = rna_in[rna_in %in% all.mirnas]
genes_in = rna_in[rna_in %in% all.genes]
gt <- as.matrix(gt_in)
diag(gt) <- 0
gt <- gt != 0
gt <- gt[mirna_in, genes_in]
noisy <- noisy_in
noisy_metrics <- function(noisy_adj, gt_in, mirna_in, genes_in, model_name = "noisy adjacency") {
noisy_mg <- as.matrix(noisy_adj)[mirna_in, genes_in, drop = FALSE]
gt_mg    <- as.matrix(gt_in)[mirna_in, genes_in, drop = FALSE]
data.frame(
model = model_name,
t(edge_metrics_rect(noisy_mg, gt_mg)),
row.names = NULL
)
}
if(is.null(noisy_in) == FALSE){
noisy <- as.matrix(noisy_in)
diag(noisy) <- 0
noisy <- noisy != 0
noisy <- noisy[mirna_in, genes_in]
res_noisy <- noisy_metrics(
noisy_adj = noisy,
gt_in = gt,
mirna_in = mirna_in,
genes_in = genes_in,
model_name = "noisy adjacency"
)
}
else{
res_noisy <- noisy_metrics(
noisy_adj = gt * 0,
gt_in = gt,
mirna_in = mirna_in,
genes_in = genes_in,
model_name = "noisy adjacency"
)
}
print("Gaussian")
fit_gauss <- fit_mirna_to_gene_glmnet(
data_in = data_in,
family = "gaussian",
ncores = 8,
prior_adj = noisy
)
print("Poisson")
fit_pois <- fit_mirna_to_gene_glmnet(
data_in = data_in,
family = "poisson",
ncores = 8,
prior_adj = noisy
)
adj_gaussian_min <- fit_gauss$lambda.min
adj_gaussian_1se <- fit_gauss$lambda.1se
adj_poisson_min <- fit_pois$lambda.min
adj_poisson_1se <- fit_pois$lambda.1se
result <- rbind(
data.frame(
model = "glmnet miRNA->gene Gaussian lambda.min",
t(edge_metrics_rect(fit_gauss$lambda.min, gt)),
row.names = NULL
),
data.frame(
model = "glmnet miRNA->gene Gaussian lambda.1se",
t(edge_metrics_rect(fit_gauss$lambda.1se, gt)),
row.names = NULL
),
data.frame(
model = "glmnet miRNA->gene Poisson lambda.min",
t(edge_metrics_rect(fit_pois$lambda.min, gt)),
row.names = NULL
),
data.frame(
model = "glmnet miRNA->gene Poisson lambda.1se",
t(edge_metrics_rect(fit_pois$lambda.1se, gt)),
row.names = NULL
)
)
Kmax <- length(mirna_in) * length(genes_in)
Ks <- round(c(0.001, 0.005, 0.01, 0.02, 0.05, 0.10, 0.15, 0.20) * Kmax)
Ks <- sort(unique(pmax(1, pmin(Ks, Kmax))))
res_cor <- do.call(rbind, lapply(Ks, function(k) {
rbind(
data.frame(
model = paste0("miRNA->gene negative Spearman K=", k),
t(edge_metrics_rect(
cor_adj_mirna_to_gene(data_in, "spearman",
top_k = k, use_negative = TRUE),
gt
)),
row.names = NULL
),
data.frame(
model = paste0("miRNA->gene negative Pearson K=", k),
t(edge_metrics_rect(
cor_adj_mirna_to_gene(data_in, "pearson",
top_k = k, use_negative = TRUE),
gt
)),
row.names = NULL
),
data.frame(
model = paste0("miRNA->gene abs Spearman K=", k),
t(edge_metrics_rect(
cor_adj_mirna_to_gene(data_in, "spearman",
top_k = k, use_negative = FALSE),
gt
)),
row.names = NULL
),
data.frame(
model = paste0("miRNA->gene abs Pearson K=", k),
t(edge_metrics_rect(
cor_adj_mirna_to_gene(data_in, "pearson",
top_k = k, use_negative = FALSE),
gt
)),
row.names = NULL
)
)
}))
fls_nm = strsplit(fld, "/", fixed=T)
fls_nm = tail(fls_nm[[1]],n=1)
all.result = rbind(res_noisy, result, res_cor)
write.csv(all.result, paste0(fld,"all_results_logCPM_",fls_nm,".csv"))
}
